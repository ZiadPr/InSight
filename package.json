{
  "name": "insight-attendance",
  "private": false,
  "version": "1.0.0",
  "description": "InSight (ان سايت) — Open-source secure QR + GPS employee attendance & workforce management platform.",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "NODE_ENV=production vite build --mode production",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/security/security.test.ts tests/attendance/attendance.test.ts tests/storage/sqlite-storage.test.ts",
    "migrate:sqlite": "tsx scripts/migrate-json-db-to-sqlite.ts",
    "audit:ci": "npm audit --audit-level=high",
    "check:licenses": "tsx scripts/check-licenses.ts",
    "check:bundle": "tsx scripts/check-bundle-secrets.ts",
    "sbom": "npx --yes @cyclonedx/cyclonedx-npm --output-format JSON --output-file sbom.cdx.json"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/hpp": "^0.2.7",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^6.1.1",
    "better-sqlite3": "^13.2.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.76.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.5",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
