# Supabase Edge Function Secrets (set via `supabase secrets set` or Supabase Dashboard).
# NEVER prefix these with VITE_ and NEVER commit real values to Git.

SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Comma-separated list of allowed frontend HTTPS origins for CORS (no wildcard in production)
ALLOWED_ORIGINS="https://your-attendance-portal.vercel.app"

# High-entropy random salts for hashing IP addresses and rotating kiosk device secrets
IP_HASH_SALT="replace-with-64-char-random-hex-string"
KIOSK_DEVICE_SECRET_SALT="replace-with-64-char-random-hex-string"
