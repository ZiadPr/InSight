# Public client configuration (NEVER add any secret key with a VITE_ prefix).
# Optional institutional display fallback before kiosk session connects
VITE_CAMPUS_DISPLAY_NAME="ان سايت — البوابة المؤسسية للحضور"

# --- Express Server Production Secrets (inject via Secret Manager / KMS; NEVER prefix with VITE_) ---
# NODE_ENV="production"
# 64-character hex AES-256-GCM master encryption key (mandatory in production; do NOT store .master.key with DB backups)
# DATA_ENCRYPTION_KEY=""
# Initial Admin & Kiosk provisioning on first production boot (only used if encrypted DB file does not exist yet)
# ADMIN_BOOTSTRAP_EMAIL=""
# ADMIN_BOOTSTRAP_PASSWORD=""
# KIOSK_BOOTSTRAP_SECRET=""
# Enforce TOTP MFA on all HR Admin operations (defaults to true in production)
# REQUIRE_ADMIN_MFA="true"
# Comma-separated trusted proxy CIDRs / hop config for Express trust proxy (e.g. "loopback" or "10.0.0.0/8")
# TRUST_PROXY="loopback"
# Enforce HTTPS / HSTS in production (defaults to true when NODE_ENV=production)
# REQUIRE_HTTPS="true"
# Comma-separated allowed CORS / frame-ancestors origins
# ALLOWED_ORIGINS="https://attendance.yourcompany.com"
# Optional distributed Redis REST backend for multi-instance rate limiting
# REDIS_REST_URL=""
# REDIS_REST_TOKEN=""
# REQUIRE_DISTRIBUTED_RATE_LIMIT="false"
# Optional SIEM / Webhook URL for real-time critical & high security alerts
# ALERT_WEBHOOK_URL=""
# Optional Cloudflare Turnstile secret key for server-side login challenge verification (site key is managed in HR Security settings)
# TURNSTILE_SECRET_KEY=""

